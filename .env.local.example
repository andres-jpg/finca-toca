# Plantilla de .env.local para desarrollo LOCAL (Supabase CLI en Docker). Cópiala a .env.local.
# Sin secretos: son las claves de DESARROLLO que imprime `pnpm db:status`, válidas solo en tu máquina.
# Nunca pongas aquí claves de staging ni de producción.

# URL local de la API (PostgREST + Auth). Es siempre esta.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# `pnpm db:status` → "Publishable key" (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=

# `pnpm db:status` → "Secret key" (sb_secret_...). Solo la usa el cron (createAdminClient).
SUPABASE_SERVICE_ROLE_KEY=

# Cualquier valor sirve en local; solo protege /api/cron/animales-estados.
CRON_SECRET=local-dev-secret
