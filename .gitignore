# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...salvo la plantilla, que no lleva secretos
!.env.local.example

# vercel
.vercel

# PWA — auto-generados en build, no committear
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/workbox-*.js.map

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase CLI local state
supabase/.temp

# local agent tooling scratch state
.claire/



# playwright (E2E): sesiones guardadas por rol, informe HTML y resultados/trazas de la última ejecución
/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/
